# Значение с пробелами или обратным слэшем пиши в одинарных кавычках:
#   SERVER_NAME='Gaming PC'
#   FFMPEG_PATH='C:\Tools\ffmpeg\bin\ffmpeg.exe'
# Внутри одинарных кавычек ничего не экранируется, слэши не нужно удваивать.
# Без кавычек такая строка не читается, и сервер не запустится.
# Кодировка файла: UTF-8 (с BOM или без) или UTF-16 с BOM.
SERVER_NAME=
FFMPEG_PATH=ffmpeg
VIDEO_ENCODER=auto
CAPTURE_BACKEND=auto
VIRTUAL_DISPLAY=on
CAPTURE_OUTPUT=0
CAPTURE_FPS=60
VIDEO_BITRATE_KBPS=40000
KEYFRAME_INTERVAL_SECONDS=2
RUST_LOG=info
