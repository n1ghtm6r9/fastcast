<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:focusable="false"
    tools:ignore="MergeRootFrame">

    <dev.fastcast.client.player.VideoSurfaceView
        android:id="@+id/video_surface"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <LinearLayout
        android:id="@+id/status_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_panel"
        android:gravity="center_horizontal"
        android:minWidth="420dp"
        android:orientation="vertical"
        android:padding="28dp">

        <ProgressBar
            android:id="@+id/status_spinner"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="@color/accent" />

        <TextView
            android:id="@+id/status_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:maxWidth="640dp"
            android:textColor="@color/text"
            android:textSize="24sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/status_leave_hint"
            android:textColor="@color/text_muted"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/stats_text"
        style="@style/OverlayText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="32dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/controls_hint"
        style="@style/OverlayText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:text="@string/player_controls_hint"
        android:visibility="gone" />

    <TextView
        android:id="@+id/debug_status"
        style="@style/OverlayText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="32dp"
        android:maxWidth="720dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/scale_toast"
        style="@style/OverlayText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="48dp"
        android:textSize="24sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/menu_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:background="@drawable/bg_panel"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/menu_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/menu_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_muted"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="120dp"
                android:text="@string/menu_screen"
                android:textColor="@color/text_muted"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/menu_screen_previous"
                style="@style/MenuButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:minWidth="64dp"
                android:text="@string/menu_step_previous" />

            <TextView
                android:id="@+id/menu_screen_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minWidth="240dp"
                android:textColor="@color/text"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/menu_screen_next"
                style="@style/MenuButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:text="@string/menu_step_next" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menu_scale_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:clipChildren="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="120dp"
                android:text="@string/menu_scale"
                android:textColor="@color/text_muted"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/menu_scale_smaller"
                style="@style/MenuButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:minWidth="64dp"
                android:text="@string/menu_scale_smaller" />

            <TextView
                android:id="@+id/menu_scale_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minWidth="240dp"
                android:textColor="@color/text"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/menu_scale_larger"
                style="@style/MenuButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:text="@string/menu_scale_larger" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:clipChildren="false"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/menu_resume"
                style="@style/MenuButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_resume" />

            <TextView
                android:id="@+id/menu_stats"
                style="@style/MenuButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/menu_stats" />

            <TextView
                android:id="@+id/menu_disconnect"
                style="@style/MenuButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/menu_disconnect" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
